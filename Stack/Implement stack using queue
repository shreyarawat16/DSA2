class MyStack {
    queue<int> q1;
    queue<int> q2;

public:
    MyStack() {
        
    }
    
    void push(int x) {
        if(empty()){
           q1.push(x);
        }
        else if(!q2.empty()){
            q2.push(x);
        }
        else{
            q1.push(x);
        }

    }
    
    int pop() {
        int ans=-1;
        if(empty()){
            return ans;
        }
        if(q2.empty()){
        while(q1.size()!=1){
            q2.push(q1.front());
            q1.pop();
        }
      
        ans= q1.front();
        q1.pop();
        }
       else if(q1.empty()){
        while(q2.size()!=1){
            q1.push(q2.front());
            q2.pop();
        }
      
        ans= q2.front();
        q2.pop();
        }
        return ans;
    }
    
    int top() {
        
        if(empty()){
            return 0;
        }
       if(q1.empty()){
        return q2.back();
       }
       else {
        return q1.back();
       }
    }
    
    bool empty() {
        return q1.empty() && q2.empty();
    }
};

