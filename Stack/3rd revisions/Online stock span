class StockSpanner {
public:
 stack<int> st;
 vector<int> arr;
    StockSpanner() {
        
    }
    
    int next(int price) {
        //OPTIMAL TC: O(2N), SC: O(N) -> at max my stack will store all the elements
        arr.push_back(price);
        int ind= arr.size()-1;
       
        //nge to left
       int ans;
        while(!st.empty() && arr[st.top()]<= arr[ind]){
            st.pop();
        }
        if(!st.empty()){
            ans= ind-st.top();
        }
        else{
            ans= ind+1;
        }
        st.push(ind);
        return ans;
        
