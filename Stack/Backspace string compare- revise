class Solution {
public:
    bool backspaceCompare(string s, string t) {
      
        stack<char> st1, st2;
      
        int n= s.size();
        int m= t.size();
        int i=0, j=0;
        while(i<n){
            if( s[i]!='#'){
                
                 st1.push(s[i]);
                 
            }
            
            else if(!st1.empty()){
                st1.pop();
                
            }
           i++;
        }
         while(j<m){
            if( t[j]!='#'){
                
                 st2.push(t[j]);
                 
            }
            
            else if(!st2.empty()){
                st2.pop();
                
            }
        j++;
        }
       
        if (st1.size() != st2.size()) return false;

        while (!st1.empty()) {
            if (st1.top() != st2.top()) return false;
            st1.pop();
            st2.pop();
        }

        return true;
    }
};
