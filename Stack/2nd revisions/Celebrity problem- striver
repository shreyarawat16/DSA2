class Solution {
  public:
    int celebrity(vector<vector<int>>& mat) {
        // code here
        //OPTIMAL
        //TC: O(2N), SC: O(1)
        int n= mat.size();
        int top=0, bottom= n-1;
        
                while(top< bottom){
                if(!mat[top][bottom] && mat[bottom][top]){
                    bottom--;
                }
                else{
                    top++;
                }
                }
           
        int ind= top;
        int rowSum=0, colSum=0;
        for(int i=0; i<n; i++){
            rowSum+= mat[ind][i];
            colSum+= mat[i][ind];
        }
        if(rowSum==1 && colSum== n){
            return ind;
        }
        return -1;
