class Solution {
public:
long long findMax(vector<int>& nums){
    int n= nums.size();
       vector<int> right(n,n);
        vector<int> left(n,-1);
        stack<int> st;
        for(int i=0; i<n; i++){
            while(!st.empty() && nums[st.top()]< nums[i]){
                st.pop();
            }
            if(!st.empty()){
               left[i]= st.top();
            }
            st.push(i);
        }
        stack<int> st1;
        for(int i=n-1; i>=0; i--){
            while(!st1.empty() && nums[st1.top()]<= nums[i]){
                st1.pop();
            }
            if(!st1.empty()){
                right[i]=st1.top();
            }
            st1.push(i);
        }
        int mod= 1e9+7;
        long long sum=0;
        for(int i=0; i<n; i++){
            sum= (sum+ (long long)nums[i]*(right[i]-i)*(i-left[i]));
        }
        return sum;
}
