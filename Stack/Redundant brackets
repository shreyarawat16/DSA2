#include <bits/stdc++.h> 
bool findRedundantBrackets(string &s)
{
    stack<char> st;
    for(int i=0; i<s.size(); i++){
        char ch= s[i];
        if(ch== '(' || ch== '+' || ch=='-' 
        || ch=='*' || ch=='/'){
            st.push(ch);
        }
        else if(ch==')') {
            bool flag= true;
            while(!st.empty() && st.top()!='('){
                char top = st.top(); st.pop();
            
           if(top=='+' || top=='-' || top=='*' || top=='/'){
               flag= false;
           }
        }
        st.pop();
        if (flag){
            return true;
        }
    }
    }
    return false;

}
