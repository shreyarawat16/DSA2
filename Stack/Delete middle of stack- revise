class Solution {
  public:
  void solve(stack<int>& st, int n, int count){
      if( count == n/2){
          st.pop();
          return;
      }
      int val =st.top();
      st.pop();
      count++;
      solve(st, n, count);
      st.push(val);
      return;
  }
    // Function to delete middle element of a stack.
    void deleteMid(stack<int>& s) {
        // code here..
        int n= s.size();
        
        solve(s,n, 0);
        return;
        
    }
};
