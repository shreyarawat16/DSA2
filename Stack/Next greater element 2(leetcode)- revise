https://leetcode.com/problems/next-greater-element-ii/

class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        //Optimized TC: O(N), SC: O(N) for using stack
        int n= nums.size();
        vector<int> ans(n,-1);
        stack<int> st;
       
        for(int i=2*n-1; i>=0; i--){
            int ind= i%n;
           while(!st.empty() && st.top()<= nums[ind]){
            st.pop();
           }
           if(st.empty()){
            ans[ind]=-1;
           }
           else{
            ans[ind]=st.top();
           }
            st.push(nums[ind]);
        }
        return ans;
    }
