class StockSpanner {
    vector<int> arr;
    stack<int> st;
public:
    StockSpanner() {
        
    }
    
    int next(int price) {
        //NGE on left
        arr.push_back(price);
        int ans;
        int ind= arr.size()-1;
            while(!st.empty() && arr[st.top()]<= arr[ind]){
             st.pop();
            }
            if(st.empty()){
               ans= ind+1;
            }
            else{
               ans= ind-st.top();
            }
            st.push(ind);
            
       
        return ans;
    }
};

