https://leetcode.com/problems/remove-k-digits/submissions/1813026414/

class Solution {
public:
    string removeKdigits(string num, int k) {
        int n= num.size();
        string ans="";
        if(n <= k){
            return "0";
        }
        if(k==0){
            return num;
        }
        stack<char> st;
        for(int i=0; i<n; i++){
          
            char ch= num[i];
           
            while(!st.empty() && ch < st.top() && k>0){
                k--;
                st.pop(); 
            }
           
               st.push(ch);
               //popping preceding zeros
               if(st.size()==1 && ch== '0'){
                 st.pop();
               }
         
        }
        while(k && !st.empty()){
            k--;
            st.pop();
        }
    while(!st.empty()){
       char ch=  st.top();
       st.pop();
       ans.push_back(ch);
    }
    reverse(ans.begin(), ans.end());
    if(ans.length()== 0){
        return "0";
    }
    return ans;
    }
};
