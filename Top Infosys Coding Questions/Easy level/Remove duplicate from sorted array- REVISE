class Solution {
  public:
    int removeDuplicates(vector<int> &arr) {
        // code here
       
       //OPTIMAL SOLUTION- 2 POINTERS
      //TC: O(N), SC:O(1)
     int i=0, j=1;
     while(j< arr.size()){
         if(arr[j]!= arr[i]){
             arr[i+1]= arr[j];
             i++;
         }
         j++;
     }
      return i+1;
