bool isCyclic(int V, vector<vector<int>> &edges) {
        // code here
        //USING TOPOLOGICAL SORT
        vector<int> vis(V,0);
        vector<int> pathVis(V,0);
        vector<vector<int>> adj(V);
        queue<int> q;
        for(auto it: edges){
            int u= it[0];
            int v= it[1];
            adj[u].push_back(v);
            
        }
        vector<int> indegree(V);
        for(int i=0; i<V; i++){
            for(auto it: adj[i]){
                indegree[it]++;
            }
        }
        for(int i=0; i<V; i++){
            if(indegree[i]==0){
                q.push(i);
            }
        }
        vector<int> topo;
        while(!q.empty()){
            int node= q.front();
            q.pop();
            topo.push_back(node);
            for(auto it: adj[node]){
                indegree[it]--;
                if(indegree[it]==0){
                    q.push(it);
                }
            }
        }
      if(topo.size()==V){
          return false;
      }
      return true;
    }
};
