// User function Template for C++

class Solution {
  public:
    int minimumMultiplications(vector<int>& arr, int start, int end) {
        // code here
          int mod= 100000;
          int n= arr.size();
          queue<pair<int,int>> q;
          vector<int> dist(mod,1e9);
          dist[start]=0;
          q.push({0,start});
          while(!q.empty()){
             
           int node= q.front().second;
           int d= q.front().first;
           if(node== end){
               return d;
           }
           q.pop();
           for(auto it: arr){
               int newNode= (node*it)%mod;
               if(1+ d< dist[newNode]){
                   dist[newNode]= 1+dist[node];
                   q.push({dist[newNode], newNode});
               }
           }
           }
           return -1;
    }
};
