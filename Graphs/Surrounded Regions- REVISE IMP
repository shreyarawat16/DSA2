https://leetcode.com/problems/surrounded-regions/submissions/1702638098/

class Solution {
public:
void DFS(int row, int col, vector<vector<char>>& board,vector<vector<int>>& vis, int n, int m ){
    vis[row][col]=1;
   
    int dr[4]={-1,0,+1,0};
    int dc[4]={0,+1,0,-1};
    for(int i=0; i<4; i++){
        int nr= row+dr[i];
        int nc= col+ dc[i];
        if(nr>=0 && nr<n && nc>=0 && nc<m && board[nr][nc]=='O' && !vis[nr][nc]){
            
            DFS(nr,nc, board, vis, n,m);
        }
    }
}
    void solve(vector<vector<char>>& board) {
        int n= board.size();
        int m= board[0].size();
        vector<vector<int>> vis(n, vector<int>(m,0));
        int dr[4]={0,-1};
        int dc[4]={-1,0};
        for(int j=0; j<m; j++){
            if(board[0][j]=='O' && !vis[0][j]){
               DFS(0,j,board,vis,n,m);
            }
            if(board[n-1][j]=='O' && !vis[n-1][j]){
                DFS(n-1,j,board,vis,n,m);
            }
        }
        for(int i=0; i<n; i++){
            if(board[i][0]=='O' && !vis[i][0]){
                DFS(i,0,board,vis,n,m);
            }
            if(board[i][m-1]=='O' && !vis[i][m-1]){
                DFS(i,m-1,board,vis,n,m);
            }
        } 
        
    for(int i=0; i<n; i++){
        for(int j=0; j<m; j++){
            if(board[i][j]=='O' && !vis[i][j]){
                board[i][j]='X';
            }
        }
    }
    }
};
