class Solution {
public:
void DFS(int row, int col, vector<vector<char>>& board, vector<vector<int>>& vis){
    vis[row][col]=1;
    int n= board.size();
    int m= board[0].size();
    int dr[4]= {-1,0,+1,0};
    int dc[4]= {0,+1,0,-1};
    for(int i=0; i<4; i++){
        int nr= row+ dr[i];
        int nc= col+ dc[i];
        if(nr>=0 && nc>=0 && nr<n && nc<m && !vis[nr][nc] && board[nr][nc]=='O'){
            DFS(nr, nc, board, vis);
        }
    }
}
    void solve(vector<vector<char>>& board) {
          int n= board.size();
          int m= board[0].size();
          vector<vector<int>> vis(n, vector<int>(m,0));
          for(int i=0; i<n; i++){
             if(board[i][0]=='O' && !vis[i][0]){
                DFS(i,0, board, vis);
             }
             if(board[i][m-1]=='O' && !vis[i][m-1]){
                DFS(i, m-1, board, vis);
             }
          }
          for(int j=0; j<m; j++){
            if(board[0][j]=='O' && !vis[0][j]){
               DFS(0,j,board, vis);
            }
            if(board[n-1][j]=='O' && !vis[n-1][j]){
                DFS(n-1,j, board, vis);
            }
          }
         for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(board[i][j]=='O' && !vis[i][j]){
                    board[i][j]= 'X';
                }
            } 
         }
        
    }
};
