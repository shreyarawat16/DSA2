class Solution {
public:
    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {
        vector<vector<int>> res= mat;
        int n= mat.size();
        int m= mat[0].size();
        vector<vector<int>> vis(n, vector<int>(m,0));
        int dr[4]= {-1,0,+1,0};
        int dc[4]= {0,+1,0,-1};
        queue<pair<pair<int, int>, int>> q;
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
               if(mat[i][j]==0){
                q.push({{i,j}, 0});
                vis[i][j]=1;
               }
            }
        }
        while(!q.empty()){
            int row= q.front().first.first;
            int col= q.front().first.second;
            int d= q.front().second;
            res[row][col]=d;
            q.pop();
            for(int i=0; i<4; i++){
                int nr= row+ dr[i];
                int nc= col+ dc[i];
                if(nr>=0 && nr<n && nc>=0 && nc<m && !vis[nr][nc] && mat[nr][nc]==1){
                    q.push({{nr, nc}, d+1});
                    vis[nr][nc]=1;
                    
                }
            }
        }
        return res;
    }
};
