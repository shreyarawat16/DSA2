        adj[u].push_back(v);
        adj[v].push_back(u);
    }
    vector<int> vis(n+1,0);
    for(int i=1; i<=n; i++){
      if(!vis[i]){
          if(BFS(i, adj, vis)){
            return "Yes";
          }
      }
    }
    return "No";
}
