#include<queue>
#include<bits/stdc++.h>
bool BFS(int start, vector<vector<int>>& grid, vector<int>& vis){
    queue<pair<int, int>> q;
    q.push({start, -1});
    vis[start]=1;

    while(!q.empty()){
        int node= q.front().first;
        int parent= q.front().second;
        q.pop();
        for(auto it: grid[node]){
           if(!vis[it]){
              q.push({it, node});
              vis[it]=1;
           }
           else if(it!= parent){
               return true;
           }
        }
    }
    return false;
}
