https://leetcode.com/problems/rotting-oranges/submissions/1751194776/

class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        int n= grid.size();
        int m= grid[0].size();
        queue<pair<pair<int, int>, int>> q;
        vector<vector<int>> vis(n, vector<int>(m,0));
        int dr[4]={-1,0,+1,0};
        int dc[4]={0,+1,0,-1};
        int time=0;
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
              if(grid[i][j]==2 && !vis[i][j]){
                 q.push({{i,j},0});
                 vis[i][j]=1;
              }
           
           }
        }
        while(!q.empty()){
            int row= q.front().first.first;
            int col= q.front().first.second;
            time= q.front().second;
            q.pop();
            for(int k=0; k<4; k++){
                int nr= row+ dr[k];
                int nc= col+ dc[k];
                if(nr>=0 && nc>=0 && nr<n && nc<m && !vis[nr][nc] && grid[nr][nc]==1){
                    q.push({{nr,nc},time+1});
                    vis[nr][nc]=1;
                    grid[nr][nc]=2;
                 }
               }
             }
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(grid[i][j]==1){
                    return -1;
                }
            }
        }
        return time;
    }
};
