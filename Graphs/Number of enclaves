class Solution {
public:
void DFS(int row,int col, vector<vector<int>>& grid, vector<vector<int>>& vis, int n, int m){
    vis[row][col]=1;
    int dr[4]={-1,0,+1,0};
    int dc[4]={0,+1,0,-1};
    for(int i=0; i<4; i++){
        int nr= row+dr[i];
        int nc=col+ dc[i];
        if(nr>=0 && nc>=0 && nr<n && nc<m && grid[nr][nc]==1 && !vis[nr][nc] ){
            vis[nr][nc]=1;
            DFS(nr, nc, grid, vis, n,m);
        }
    }
}
    int numEnclaves(vector<vector<int>>& grid) {
        int n= grid.size();
        int m= grid[0].size();
        vector<vector<int>> vis(n, vector<int>(m,0));
        //first row check
        for(int j=0; j<m; j++){
          if( grid[0][j] == 1 && !vis[0][j]){
           
            DFS(0,j, grid, vis,n,m);
          }
        }
        //last row
        for(int j=0; j<m; j++){
          if( grid[n-1][j] == 1 && !vis[n-1][j]){
           
            DFS(n-1,j, grid, vis,n,m);
          }
        }
        //first column
        for(int i=0; i<n; i++){
            if(grid[i][0]==1 && !vis[i][0]){
                
            DFS(i,0, grid, vis,n,m);
            }
        }
        //last col
        for(int i=0; i<n; i++){
            if(grid[i][m-1]==1 && !vis[i][m-1]){
                
               DFS(i,m-1, grid, vis,n,m);
            }
        }
        int cnt=0;
         for(int i=0; i<n; i++){
             for(int j=0; j<m; j++){
                if(grid[i][j]==1 && !vis[i][j]){
                    cnt++;
                }
             }
         }
         return cnt;
    }
};

