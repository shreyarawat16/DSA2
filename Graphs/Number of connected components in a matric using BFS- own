int numIslands(vector<vector<char>>& grid) {
        int n= grid.size();
        int m= grid[0].size();
        int dr[4]={-1,0,+1,0};
        int dc[4]={0,+1,0,-1};
        int cnt=0;
        queue<pair<int, int>> q;
        vector<vector<int>> vis(n, vector<int>(m,0));
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(grid[i][j]=='1' && !vis[i][j]){
                    cnt++;
                    q.push({i,j});
                    vis[i][j]=1;
                    
                }
                while(!q.empty()){
                int row= q.front().first;
                int col= q.front().second;
                q.pop();
                for(int i=0; i<4; i++){
                int nr= row+ dr[i];
                int nc= col+ dc[i];
                if(nr>=0 && nr<n && nc>=0 && nc<m && grid[nr][nc]=='1' && !vis[nr][nc]){
                    vis[nr][nc]=1;
                    q.push({nr,nc});
                 }
               }
              }
            }
        }
        
        return cnt;
    }
