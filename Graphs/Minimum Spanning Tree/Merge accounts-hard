class DisjointSet{
    private:
    vector<int> parent;
    vector<int> size;
    public:
    DisjointSet(int n){
        parent.resize(n);
        size.resize(n,1);
        for(int i=0; i<n; i++){
            parent[i]=i;
        }
    }
    int findParent(int u){
        if(parent[u]==u){
            return parent[u];
        }
        return findParent(parent[u]);
    }
    void UnionBySize(int u, int v){
        int pu= findParent(u);
        int pv= findParent(v);
        if(pu== pv){
            return;
        }
        if(size[pu]> size[pv]){
            parent[pv]=pu;
            size[pu]+= size[pv];
        }
        else{
            parent[pu]=pv;
            size[pv]+= size[pu];
        }
    }
};
class Solution {
public:
    vector<vector<string>> accountsMerge(vector<vector<string>>& accounts) {
        unordered_map<string, int> mp;
        int n=accounts.size();
        DisjointSet ds(n);
        for(int i=0 ; i<accounts.size(); i++){
           vector<string> temp= accounts[i];
            for(int j=1; j< temp.size(); j++){

             if(mp.find(temp[j])==mp.end() ){
                 mp[temp[j]]=i;
             }
            else{
                 ds.UnionBySize(mp[temp[j]],i);
             } 
           }
        }
        vector<vector<string>> temp(n);
        for(auto it: mp){
            string str=it.first;
            int index= it.second;
            int pind= ds.findParent(index);
            temp[pind].push_back(str);
        }
        vector<vector<string>> ans;
        for(int i=0; i<n; i++){
            if(temp[i].size()==0) continue;
            sort(temp[i].begin(), temp[i].end());
            vector<string> temp2;
            temp2.push_back(accounts[i][0]);
            
            for(auto it: temp[i]){
                temp2.push_back(it);
            }
            ans.push_back(temp2);
        }
        return ans;
    }
};
