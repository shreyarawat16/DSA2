class DisjointSet {
    
     vector<int> size;
     vector<int> par;
public:
    DisjointSet(int n) {
    
     size.resize(n,1);
     par.resize(n,0);
      for(int i=0; i<n; i++){
        par[i]=i;
      }
    }
int findParent(int u){
    if(par[u]==u){
        return u;
    }
  return findParent(par[u]);
}
    bool find(int u, int v) {
      int pu= findParent(u);
       int pv= findParent(v);
       if(pu== pv){
        return true;
       }
       else{
        return false;
       }
    }

  

    void unionBySize(int u, int v) {
       int pu= findParent(u);
       int pv= findParent(v);
       if(pu== pv){
        return;
       }
       if(size[pu]> size[pv]){
         par[pv]= pu;
         size[pu]+= size[pv];
       }
       else if(size[pu]< size[pv]){
         par[pu]=pv;
         size[pv]+= size[pu];
       }
       else{
        par[pu]= pv;
        size[pv]+= size[pu];
       }
    }
};
