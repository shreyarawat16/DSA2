class DisjointSet{
    private:
    vector<int> parent;
    vector<int> size;
    public:
    DisjointSet(int n){
        parent.resize(n);
        size.resize(n,1);
        for(int i=0; i<n; i++){
            parent[i]=i;
        }
    }
    int findParent(int u){
        if(parent[u]==u){
            return u;
        }
        return findParent(parent[u]);
    }
    void UnionBySize(int u, int v){
        int pu= findParent(u);
        int pv= findParent(v);
        if(pu== pv){
            return;
        }
        if(size[pu]> size[pv]){
            parent[pv]=pu;
            size[pu]+= size[pv];
        }
        else{
            parent[pu]=pv;
            size[pv]+= size[pu];
        }
    }
};
class Solution {
public:
    int makeConnected(int n, vector<vector<int>>& connections) {
        if(connections.size()< n-1){
            return -1;
        }
        DisjointSet ds(n);
        int cnt=0;
        for(auto it: connections){
            int u= it[0];
            int v= it[1];
            int pu= ds.findParent(u);
            int pv= ds.findParent(v);
             if(pu!= pv){
                ds.UnionBySize(u,v);
             }
        }
        for(int i=0; i<n ; i++){
            if(ds.findParent(i)==i){
                cnt++;
            }
        }
        return cnt-1;
    }
};
