https://leetcode.com/problems/number-of-islands/submissions/1751064299/

class Solution {
public:
    int numIslands(vector<vector<char>>& grid) {
        int n= grid.size();
        int m= grid[0].size();
        vector<vector<int>> vis(n, vector<int>(m,0));
        queue<pair<int,int>> q;
        int count=0;
        int dr[4]={-1,0,+1,0};
        int dc[4]={0,+1,0,-1};
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(grid[i][j]=='1' && !vis[i][j]){
                    count++;
                    q.push({i,j});
                    vis[i][j]=1;
                }
                    while(!q.empty()){
                        int row= q.front().first;
                        int col= q.front().second;
                        q.pop();
                         for(int k=0; k<4; k++){
                            int nr= row+ dr[k];
                            int nc= col+ dc[k];
                            if(nr>=0 && nr<n && nc>=0 && nc<m && !vis[nr][nc] && grid[nr][nc]=='1'){
                                q.push({nr, nc});
                                vis[nr][nc]=1;
                            }
                         }
                    }
                }
            }
        
        return count;
    }
};
