https://leetcode.com/problems/flood-fill/submissions/1751209187/

class Solution {
public:
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        int originalColor= image[sr][sc];
        vector<vector<int>> updated= image;
        int n= image.size();
        int m= image[0].size();
        int dr[4]={-1,0,+1,0};
        int dc[4]={0,+1,0,-1};
        vector<vector<int>> vis(n, vector<int>(m,0));
        queue<pair<int,int>> q;
        q.push({sr,sc});
        vis[sr][sc]=1;
        updated[sr][sc]=color;
        while(!q.empty()){
            int row= q.front().first;
            int col= q.front().second;
            q.pop();
            for(int i=0; i<4; i++){
                int nr= row+dr[i];
                int nc= col+ dc[i];
                if(nr>=0 && nc>=0 && nc<m && nr<n && !vis[nr][nc] && image[nr][nc]== originalColor){
                    vis[nr][nc]=1;
                    q.push({nr,nc});
                    updated[nr][nc]=color;
                }
            }
        }
        return updated;
    }
};
