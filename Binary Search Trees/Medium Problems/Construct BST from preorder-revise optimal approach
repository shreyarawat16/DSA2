//OPTIMAL
//TC: O(n) as each element of preorder is processed exactly once.
//SC: O(h) -recursion depth which can be O(LOGN) for balanced tree and O(N) for skewed tree
TreeNode* solve(vector<int>& pre, int mini, int maxi, int& i){
    if(i== pre.size() || pre[i]> maxi || pre[i]< mini){
        return NULL;
    }
  TreeNode* root= new TreeNode(pre[i]);
  i++;
   root->left= solve(pre, mini, root->val, i);
   root->right= solve(pre, root->val, maxi, i);
   return root;
}
 TreeNode* bstFromPreorder(vector<int>& preorder){
    int i=0;
   return solve(preorder, INT_MIN, INT_MAX, i);
 }
