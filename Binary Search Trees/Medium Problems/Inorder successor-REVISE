class Solution {
  public:
    // returns the inorder successor of the Node x in BST (rooted at 'root')
    int inOrderSuccessor(Node *root, Node *x) {
        // Your code here
        int ans=-1;
        if(root==NULL){
            return ans;
        }
        Node* curr=root;
        while(curr){
            if(x->data< curr->data){
                ans= curr->data;
                curr=curr->left;
            }
            else {
                curr=curr->right;
            }
        }
        return ans;
    }
};
