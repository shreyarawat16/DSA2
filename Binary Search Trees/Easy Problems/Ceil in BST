int findCeil(Node* root, int input) {
//TC: O(LOGN), SC:O(1)
    // Your code here
    if(root==NULL){
        return -1;
    }
    if(root->data== input){
        return root->data;
    }
    int ceil=-1;
    while(root){
      if(input== root->data){
            ceil=input;
            break;
        }
      else if(input< root->data){
        
         ceil= root->data;
          root= root->left;
        
      }
     else{
        root=root->right;
     } 
    }
    return ceil;
}
