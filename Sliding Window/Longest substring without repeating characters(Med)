class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        //BRUTE FORCE APPROACH. TC: O(N*N), SC: O(N)
        // int n= s.length();
        // int maxi=0;
        // for(int i=0; i<n; i++){
        //   unordered_map<char, int> mp;
        //     for(int j=i;j<n; j++){
        //         if(mp.find(s[j])!= mp.end()){
        //             break;
        //         }
        //         else{
        //           mp[s[j]]++;
        //          maxi= max(maxi, j-i+1);
                 
        //         }
        //     }
        // }
        //     return maxi;
        // }
        int l=0, r=0;
        unordered_map<char, int> mp;
        int n= s.length();
        int maxi= 0;
        while(r<n){
            if(mp.find(s[r])!= mp.end()){
               if(mp[s[r]] >= l){
                l= mp[s[r]]+1;
               }
            }
            mp[s[r]] = r;
            maxi= max(maxi, r-l+1);
            r++;
        }
        return maxi;
    }
    
};

