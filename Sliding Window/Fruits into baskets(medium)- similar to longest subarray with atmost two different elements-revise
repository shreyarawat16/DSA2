    //More Optimal TC: O(N), SC: O(N)
    int l=0, r=0, n= fruits.size(), maxi=0;
    unordered_map<int, int> mp;
    while(r<n){
        mp[fruits[r]]++;
        if(mp.size()>2){
            mp[fruits[l]]--;
            if(mp[fruits[l]]==0){
                mp.erase(fruits[l]);
            }
            l++;
        }
       
        maxi= max(maxi, r-l+1);
        r++;
    }
    return maxi;
