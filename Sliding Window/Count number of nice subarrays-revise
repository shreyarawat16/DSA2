int solve(vector<int>& nums, int goal){
     int l=0, r=0, countodd=0,ans=0, n=nums.size();
        if(goal<0) return 0;
        while(r<n)
      {
            if(nums[r]%2!=0){
                countodd++;
            }
            while(countodd> goal){
              if(nums[l]%2!=0){
                countodd--;
              }
              l++;
            }
            
            ans+= r-l+1;
            
            r++;
      
      } 
      return ans;
   }

