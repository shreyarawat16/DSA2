class Solution {
public:
    int numberOfSubarrays(vector<int>& nums, int k) {
       //BRUTE TC: O(N*N)
    //    int n= nums.size(),ans=0;
    //    for(int i=0; i<n; i++){
    //     int countodd=0;
    //     for(int j=i; j<n; j++){
    //         if(nums[j]%2!=0){
    //             countodd++;
               
    //         }
    //          if(countodd==k){
    //               ans++;
    //          }
    //             else if(countodd>k){
    //                 break;
    //             }
            
    //     }
    //    }
    //   return ans;

    //OPTIMAL- PREFIX SUM + HASHMAP
    unordered_map<int, int> mp;
    mp[0]++;
    int presum=0, n= nums.size(), ans=0;
    for(int i=0; i<n; i++){
        if(nums[i]%2!=0){
            presum++;
        }
        int target=-1;
        if(presum>=k){
            target= presum-k;
        }
        if(mp.find(target)!= mp.end()){
            ans+=mp[target];
        }
       
      mp[presum]++;
    }
    return ans;
    }
};
