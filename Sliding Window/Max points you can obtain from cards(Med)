class Solution {
public:
//TC: O(K+K), SC: O(1)
 
    int maxScore(vector<int>& cardPoints, int k) {
        int n= cardPoints.size();
        int sum=0, maxi=INT_MIN;
        for(int i=0; i<k; i++){
            sum+= cardPoints[i];
            maxi= max(maxi, sum);
        }
        int i=k-1, j=n-1;
        while(i>=0){        //O(K)
        sum= sum-cardPoints[i];
        sum= sum+ cardPoints[j];
        maxi= max(maxi, sum);
        i--; j--;
        }
        return maxi;
    }
};
