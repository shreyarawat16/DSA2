        //MOST OPTIMAL
           unordered_map<char, int> freqs;
        int res = 0, r = 0, l=0, maxFreq = 0;
        while(r<s.size()) {
            freqs[s[r]]++;
            maxFreq = max(maxFreq, freqs[s[r]]);
            
            if((r-l+1)-maxFreq > k) {
                freqs[s[l]]--;
                
                l++;
            }
            res = max(res, r-l + 1);
            r++;
        }
