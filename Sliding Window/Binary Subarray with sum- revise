int solve(vector<int>& nums, int goal){
     int l=0, r=0, count=0,sum=0, n=nums.size();
        if(goal<0) return 0;
        while(r<n)
      {
       sum+= nums[r];
       while(sum> goal){
          sum-= nums[l];
          l++;
       }
       count+= r-l+1;
       r++;
      } 
      return count;
   }


        //SLIDING WINDOW
    int numSubarraysWithSum(vector<int>& nums, int goal) {
      return solve(nums, goal)- solve(nums, goal-1);
   }
