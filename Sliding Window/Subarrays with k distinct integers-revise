class Solution {
public:
int solve(vector<int>& nums, int k){
    int l=0, r=0, n= nums.size(), count=0;
    unordered_map<int, int> mp;
    while(r<n){
        mp[nums[r]]++;
        while(mp.size()>k){
          mp[nums[l]]--;
          if(mp[nums[l]]==0){
            mp.erase(nums[l]);
          }
          l++;
        }
        
        count+= r-l+1;
        r++;
    }
    return count;
}
