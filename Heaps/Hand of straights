class Solution {
public:
    bool isNStraightHand(vector<int>& hand, int groupSize) {
         int n= hand.size();
         unordered_map<int, int> mp;
         for(int i=0; i< hand.size(); i++){
            mp[hand[i]]++;
         }
         priority_queue<int, vector<int>, greater<int>> pq;
         for(auto it: mp){
          pq.push(it.first);
         }
         while(!pq.empty()){
            int val= pq.top();
            for(int i=val; i<val+groupSize; i++){
                if(mp.find(i)== mp.end()){
                    return false;
                }
                else{
                    mp[i]--;
                }
                if(!pq.empty() && mp[i]==0){
                    pq.pop();
                }
            }
         }
         return true;
    }
};
