class Solution {
  public:
    void nearlySorted(vector<int>& arr, int k) {
        // code
        //Use a min heap
        //TC: O(NLOGK) as I'm pushing only k elements at a time and as push 
        //operation of pq takes o(logk) times so for n elements it would be O9nlogk
        priority_queue<int, vector<int>, greater<int>> pq;
        int j=0;
        for(int i=0; i< arr.size(); i++){
            pq.push(arr[i]);
            if(pq.size()>k){
                arr[j]= pq.top();
                pq.pop();
                j++;
            }
        }
        while(!pq.empty()){
            arr[j]= pq.top();
            pq.pop();
            j++;
        }
    }
};
