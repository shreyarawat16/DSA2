https://leetcode.com/problems/rank-transform-of-an-array/submissions/1690837430/

class Solution {
public:

    vector<int> arrayRankTransform(vector<int>& arr) {
        int n= arr.size();
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;
        for(int i=0; i<arr.size(); i++){
            pq.push({arr[i], i});
        }
        vector<int> ans(n);
        int rank=1;
        while(!pq.empty()){
            int ind= pq.top().second;
            int ele= pq.top().first;
            pq.pop();
              ans[ind]= rank;
             if(ele!= pq.top().first){
                rank++;
             }
             
        }
        return ans;
    }
};
