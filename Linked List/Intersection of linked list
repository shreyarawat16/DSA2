https://leetcode.com/problems/intersection-of-two-linked-lists/submissions/1724050932/

class Solution {
public:
    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {
        if(headA== headB){
            return headA;
        }
        if(headA==NULL){
          return headB;
        }
        if(headB==NULL){
         return headA;
        }

        ListNode* tempA= headA, *tempB= headB;
        int len1=0, len2=0;
        while(tempA!= NULL){
            len1++;
            tempA=tempA->next;
        }
        while(tempB!= NULL){
            len2++;
            tempB= tempB->next;
        }
        tempA= headA, tempB= headB;
        if(len2> len1){
           while(len2!=len1){
            tempB=tempB->next;
            len2--;
           }
        }
        else if(len1> len2){
            while(len1 != len2){
                tempA= tempA->next;
                len1--;
            }
        }
        while(tempA != tempB){
            
            tempA= tempA->next;
            tempB= tempB->next;
        }
        return tempA;
    }
};
