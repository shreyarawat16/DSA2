https://leetcode.com/problems/merge-in-between-linked-lists/submissions/1725279491/
class Solution {
public:
    ListNode* mergeInBetween(ListNode* list1, int a, int b, ListNode* list2) {
        ListNode* temp= list1;
        int i=0;
        while(i<a-1 && temp!=NULL){
           i++;
           temp= temp->next;
        }
        int j=0;
        ListNode* temp2= list1;
        while(j<=b && temp2!=NULL){
            j++;
            temp2= temp2->next;
        }
        temp->next= list2;
        while(list2->next!=NULL){
            list2= list2->next;
        }
        list2->next=temp2;
        return list1;
    }
};
