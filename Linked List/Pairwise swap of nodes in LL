https://www.geeksforgeeks.org/problems/pairwise-swap-of-nodes-in-linkelist/1


class Solution {
  public:
    Node *pairwiseSwap(Node *head) {
        // code here
        if(head==NULL){
            return NULL;
        }
        if(head->next==NULL){
            return head;
        }
        Node* temp= head;
        while(temp && temp->next){
           Node* nextnode= temp->next;
             int t= temp->data;
             temp->data= nextnode->data;
             nextnode->data= t;
             
             temp= nextnode->next;
        }
        return head;
    }
};
