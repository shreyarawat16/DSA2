vector<pair<int, int>> findPairs(Node* head, int k)
{
    // Write your code here.
    Node* i=head, *j=head;
    while(j->next!=NULL){
        j=j->next;
    }
    vector<pair<int,int>> ans;
    while(i->data< j->data){
     int sum= i->data+ j->data;
     if(sum>k){
         j= j->prev;
     }
     else if(sum<k){
         i=i->next;
     }
     else if(sum==k){
         pair<int,int> p= {i->data, j->data};
         ans.push_back(p);
         i=i->next;
         j=j->prev;
     }
    }
return ans;
}
