class Solution {
public:
ListNode* reverseLL(ListNode* head){
    if(head==NULL || head->next==NULL){
        return head;
    }
 ListNode* curr= head, *prev=NULL, *forw=NULL;
 while(curr!=NULL){
    forw= curr->next;
    curr->next= prev;
    prev= curr;
    curr= forw;
 }
 return prev;
}
    ListNode* reverseKGroup(ListNode* head, int k) {
           if(head==NULL || head->next==NULL){
             return head;
           } 
        
           int len=1;
           ListNode* temp=head;
           while(temp!=NULL && len<k){
             len++;
             temp=temp->next;
           }
           if(temp==NULL){
            return head;
           }
            ListNode* nextNode= temp->next;
            temp->next=NULL;
           ListNode* newhead= reverseLL(head);
           head->next= reverseKGroup(nextNode,k);
           return newhead;
    }
};
