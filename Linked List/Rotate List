class Solution {
public:
//METHOD 1
//TC: O(N)+O(K.N)= O(K.N)
    ListNode* rotateRight(ListNode* head, int k) {
        if(head==NULL || head->next==NULL){
            return head;
        }
        if(k==0){
            return head;
        }
        int len=0;
        ListNode* temp= head;
        while(temp!=NULL){ //O(N)
            len++;
            temp=temp->next;
        }
        k= k%len;
        for(int i=0; i<k; i++){  O(K), TC: O(K.N)
            ListNode* tail= head, *prev=NULL;
            while(tail->next){  O(N)
                prev=tail;
                tail=tail->next;
            }
            prev->next=NULL;
            tail->next=head;
            head=tail;
        }
        return head;
    }
};

//METHOD 2

class Solution {
public:
//TC: O(N)+ O(N-K)= O(2N) in worst case= O(N)
    ListNode* rotateRight(ListNode* head, int k) {
        if(head==NULL || head->next==NULL){
            return head;
        }
        
        int len=1;
        ListNode* temp= head;
        while(temp->next!=NULL){  //O(N)
            len++;
            temp=temp->next;
        }
        k= k%len;
        if(k==0) return head;
        ListNode* newtail= head;
        int i=1;
        while(i< len-k && newtail){ //O(N-K)
            newtail= newtail->next;
            i++;
        }
        ListNode* newhead= newtail->next;
        newtail->next= NULL;
        temp->next=head;
        return newhead;
    }
};
