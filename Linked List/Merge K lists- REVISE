 //TC: O(KLOGK)+ O(NLOGK)= O(N+K LOGK)= O(NLOGK)
 //SC: O(K) heap hold k elements at most
 struct ListNodeComp{
 bool operator() (ListNode* a, ListNode* b){
    return a->val > b->val;
}
};
class Solution {
public:

    ListNode* mergeKLists(vector<ListNode*>& lists) {
        int k= lists.size();
    priority_queue<ListNode*, vector<ListNode*>, ListNodeComp> pq;
        for(int i=0; i<k; i++){ 
            if(lists[i]!=NULL){
              pq.push(lists[i]); //O(KLOGK)
          }
        }
        ListNode* dummy= new ListNode(-1), *curr=dummy;
        while(!pq.empty()){ //O(N)- N is total elements across all lists
            ListNode* node= pq.top();//at a time there will be 3 nodes in pq, so  for N nodes TC: O(NlogK)
            pq.pop();
            curr->next= node;
            curr=node;
            
            if(node->next){
                pq.push(node->next);
            }
        }
        curr->next=NULL;
       return dummy->next;
    }
};
