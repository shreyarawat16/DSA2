        //OPTIMAL- Recursion
        Node* mergeLL(Node* l1, Node* l2){
            if(l1==NULL && l2==NULL){
                return NULL;
            }
            if(l1==NULL){
                return l2;
            }
            if(l2== NULL){
                return l1;
            }
            Node* dummy= new Node(-1);
            Node* curr=dummy;
            while(l1 && l2){
                if(l1->data < l2->data){
                    curr->bottom= l1;
                    curr= l1;
                    l1=l1->bottom;
                }
                else{
                    curr->bottom= l2;
                    curr= l2;
                    l2=l2->bottom;
                }
                curr->next=NULL;
            }
            while(l1){
                curr->bottom= l1;
                curr=l1;
                l1=l1->bottom;
            }
            while(l2){
                curr->bottom= l2;
                curr=l2;
                l2=l2->bottom;
            }
            return dummy->bottom;
        }
    Node *flatten(Node *root) {
        if(root==NULL || root->next==NULL){
             return root;
        }
        Node* temp= root;
       Node* temp2= flatten(root->next);
       temp->next=NULL;
       Node* head= mergeLL(temp, temp2);
       return head;
    }
};
