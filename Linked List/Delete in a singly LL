https://www.geeksforgeeks.org/problems/delete-a-node-in-single-linked-list/1

class Solution {
  public:
    /* Function to delete a node from a linked list */
    Node* deleteNode(Node* head, int x) {
        // code here
        if(head==NULL){
            return NULL;
        }
        if(x==1){
            Node* temp=head;
            head= head->next;
            delete temp;
            return head;
        }
        int count=1;
        Node* temp=head;
        while(count< x-1 && temp){
            count++;
            temp=temp->next;
        }
        if(temp->next==NULL){
            return head;
        }
        Node* todelete= temp->next;
        if(todelete->next!=NULL){
            temp->next= todelete->next;
            delete todelete;
        }
        else{
            temp->next=NULL;
        }
        return head;
    }
    
};
