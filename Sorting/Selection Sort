Best case TC: O(N*N)
Avg case TC: O(N*N)
Best case TC: O(N*N)

class Solution {
  public:
    // Function to perform selection sort on the given array.
    void selectionSort(vector<int> &arr) {
        // code here
        int n= arr.size();
        for(int i=0; i<n-1; i++){
            int mini= arr[i], minind= i;
            for(int j=i+1; j<n; j++){
                if(arr[j]< mini){
                 mini= arr[j];
                 minind= j;
                }
            }
            int temp= arr[i];
            arr[i]= arr[minind];
            arr[minind]=temp;
        }
    }
};
