class Solution {
  public:
    queue<int> reverseFirstK(queue<int> q, int k) {
        // code here
        stack<int> st;
        int n= q.size();
        if(k>n){
            return q;
        }
        while(k!=0){
            st.push(q.front());
            q.pop();
            k--;
        }
        int size= q.size();
        while(!st.empty()){
            q.push(st.top());
            st.pop();
        }
        for(int i=0; i<size; i++){
            q.push(q.front());
            q.pop();
        }
        return q;
    }
};
