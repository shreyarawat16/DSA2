//SC: O(1) sorting will take constant space, new variables like i,j,k will also take constant space, ans storage space will depend on how many triplets are found
        sort(nums.begin(), nums.end()); //O(NLOGN)
        int n=nums.size();
        vector<vector<int>> ans;
      
        for(int i=0; i<n; i++){   //O(N)
            if(i>0 && nums[i]==nums[i-1]){
                
                continue;
            }
           
           
            int k=i+1, j=n-1;
            while(k<j){   //O(N)
           
           int sum= nums[i]+nums[j]+nums[k];
            if(sum==0){
                ans.push_back({nums[i], nums[k], nums[j]});
                k++; j--;
              while(k<j && nums[k]== nums[k-1]) {
                k++;
              }
              while(k<j && nums[j]== nums[j+1]){
                j--;
              }
              
            }
            else if(sum<0){
