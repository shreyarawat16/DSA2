https://leetcode.com/problems/combination-sum/submissions/1685082255/

class Solution {
public:
void solve(int i, int target, vector<int>& nums, vector<vector<int>>& ans, vector<int> temp){
    if(target==0){
        ans.push_back(temp);
        return;
    }
    if(target<0 || i==nums.size()){
        return;
    }
    //exclude
    solve(i+1, target, nums, ans, temp);
    //include
    temp.push_back(nums[i]);
    solve(i, target-nums[i], nums, ans, temp);
    
}
    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        vector<vector<int>> ans;
        vector<int> temp;
        int i=0;
        solve(i,target,candidates, ans, temp);
        return ans;
    }
};
