https://www.geeksforgeeks.org/problems/check-if-there-exists-a-subsequence-with-sum-k/1

class Solution {
  public:
  bool solve(vector<int>& arr,  int n, int target, int i){
      if(target==0){
          return true;
      }
      if(i== arr.size() || target<0){
          return false;
      }
      //include
      
      
      return solve(arr,  n, target-arr[i], i+1)||
      
      //exclude
      solve(arr,  n, target, i+1);
      
      
  }
    bool checkSubsequenceSum(int n, vector<int>& arr, int k) {
        // Code here
        
        return solve(arr,n, k, 0);
    }
};
