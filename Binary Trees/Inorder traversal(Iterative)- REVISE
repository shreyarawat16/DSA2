 vector<int> inorderTraversal(TreeNode* root) {
          vector<int> ans;
          stack<TreeNode* > st;
          
          TreeNode* curr= root;
          while(curr!=NULL ||  !st.empty()){
            while(curr!= NULL){
            st.push(curr);
            curr = curr->left;
            }
             TreeNode* node= st.top(); st.pop();
             ans.push_back(node->val);
             curr= node->right;
            
          }
          return ans;
       }
