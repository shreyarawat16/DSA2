https://leetcode.com/problems/construct-binary-tree-from-inorder-and-postorder-traversal/submissions/1730474489/

class Solution {
public:
TreeNode* solve(vector<int> postorder, int ps, int pe, vector<int> inorder, int is, int ie){
    if(is> ie || ps>pe){
        return NULL;
    }
    TreeNode* root= new TreeNode(postorder[pe]);
    int ind=-1;
    for(int i=is; i<=ie; i++){
        if(inorder[i]== postorder[pe]){
            ind= i;
            break;
        }
    }
    int numsOnLeft= ind-is;
    root->left= solve(postorder, ps, ps+numsOnLeft-1, inorder, is, ind-1);
    root->right= solve(postorder,ps+numsOnLeft, pe-1, inorder, ind+1, ie );
    return root;
}
    TreeNode* buildTree(vector<int>& inorder, vector<int>& postorder) {
        return solve(postorder,0, postorder.size()-1, inorder, 0, inorder.size()-1);
    }
};
