class Solution {
public:
TreeNode* inpre(TreeNode* root){
    TreeNode* pre= root->left, * ans= root->left;
    while(pre->right && pre->right!=root){
        pre= pre->right;
        ans=pre;
    }
    return ans;
}
    vector<int> preorderTraversal(TreeNode* root) {
        //MORRIS TRAVERSAL. TC: O(N), SC: O(1)
        vector<int> ans;
        if(root==NULL){
            return ans;
        }
        TreeNode* curr= root;
        while(curr){
            if(curr->left!= NULL){
              
              TreeNode* ip= inpre(curr);
              if(ip->right==NULL){
                ip->right= curr;
                ans.push_back(curr->val);
                curr= curr->left;
              }
              else{
                ip->right=NULL;
                curr= curr->right;
              }
            }
            else{
               ans.push_back(curr->val);
               curr=curr->right;
            }
        }
        return ans;
    }
};
