https://leetcode.com/problems/construct-binary-tree-from-preorder-and-inorder-traversal/submissions/1730463604/

class Solution {
public:
TreeNode* solve(vector<int>& pre, int ps, int pe, vector<int>& inorder, int is, int ie){
    if(is> ie || ps> pe){
        return NULL;
    } 
     int val= pre[ps];
      TreeNode* root= new TreeNode(val);
      int ind=-1;
      for(int i=is; i<= ie; i++){
        if(inorder[i]== pre[ps]){
            ind=i;
            break;
        }
      }
      int numsOnLeft= ind-is;
      root->left= solve(pre, ps+1, ps+numsOnLeft, inorder, is,ind-1);
      root->right= solve(pre, ps+numsOnLeft+1, pe, inorder, ind+1, ie);
      return root;
}
    TreeNode* buildTree(vector<int>& preorder, vector<int>& inorder) {
        return solve(preorder,0, preorder.size()-1, inorder, 0, inorder.size()-1);
    }
};
