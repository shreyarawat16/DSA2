class Solution {
  public:
  void findParent(Node* root, unordered_map<Node*, Node*>& mp)
    {
        if(root==NULL){
            return;
        }
        if(root->left){
            mp[root->left]= root;
        }
        if(root->right){
            mp[root->right]=root;
        }
        findParent(root->left, mp);
        findParent(root->right, mp);
    }
Node* findTargetNode(Node* root, int target){
    if(root==NULL){
        return NULL;
    }
    if(root->data== target){
        return root;
    }
    Node* left=findTargetNode(root->left, target);
    if(left!=NULL){
        return left;
    }
    Node* right= findTargetNode(root->right, target);
    if(right!=NULL){
        return right;
    }
    return NULL;
} 
    int minTime(Node* root, int target) {
        // code here
        int time=0;
        if(root==NULL){
            return time;
        }
        unordered_map<Node*, Node*>mp;
        findParent(root, mp);
        unordered_map<Node*, int> vis;
        queue<Node*> q;
        Node* startNode= findTargetNode(root, target);
       if(startNode!=NULL){
        q.push(startNode);
        vis[startNode]=1;
       }
        while(!q.empty()){
            int size= q.size();
            for(int i=0; i<size; i++){
              Node* node= q.front();
              q.pop();
              if(node->left && !vis[node->left]){
                  q.push(node->left);
                  vis[node->left]=1;
              }
              if(node->right && !vis[node->right]){
                  q.push(node->right);
                  vis[node->right]=1;
              }
              if(mp[node] && !vis[mp[node]]){
                  q.push(mp[node]);
                  vis[mp[node]]=1;
              }
            }
            time++;
        }
        return time-1;
    }
};
