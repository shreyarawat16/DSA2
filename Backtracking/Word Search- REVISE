https://leetcode.com/problems/word-search/submissions/1692031931/

class Solution {
public:
//TC: O(N*M * 4^L) where L= word.size()
//SC: O(N*M + L) -> visited array + DFS recursion stack
bool search(vector<vector<char>>& board, string word, vector<vector<int>>& vis,int r, int c, int n, int m, int dr[], int dc[], int k){
       if(k == word.size()) return true;
       if (r < 0 || r >= n || c < 0 || c >= m || vis[r][c] || board[r][c] != word[k]) {
    return false;
}
       vis[r][c]=1;
       for(int i=0; i<4; i++){
        int nr= r+dr[i];
        int nc= c+ dc[i];  
            if(search(board, word, vis,nr, nc, n,m, dr, dc, k+1)) return true; 
       }
       vis[r][c]=0;
       return false;
}
    bool exist(vector<vector<char>>& board, string word) {
         int n= board.size();
        int m= board[0].size();
         int dr[]={-1,0,+1,0};
         int dc[]={0,+1,0,-1};
         vector<vector<int>> vis(n, vector<int>(m,0));
         for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
               if(board[i][j]== word[0]){
                  if(search(board, word ,vis,i,j,n,m, dr,dc,0)){
                    return true;
                  }
               }
            }
        }
        return false;
    }
};

