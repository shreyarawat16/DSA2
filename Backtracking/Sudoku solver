class Solution {
public:
//TC: O(9^no. of empty cells)
bool isvalid(vector<vector<char>>& board, char ch, int row, int col){
     
     for(int i=0; i<9; i++){
        if(board[i][col]==ch){
            return false;
        }
        if(board[row][i]== ch){
            return false;
        }
     }
        int sr= (row/3)*3, sc= (col/3)*3;
        for(int r=sr; r<=sr+2; r++){
            for(int c=sc; c<= sc+2; c++){
                if(board[r][c]== ch){
                    return false;
                }
            }
        }
    
    return true;
}  
    bool solve(vector<vector<char>>& board, int row, int col) {
        if(row==9){
            return true;
        }
        int nr=row, nc=col+1;
        if(nc==9){
            nc=0, nr=row+1;
        }
        if(board[row][col]!= '.'){
            return solve(board, nr, nc);
        }
            
        for(char ch='1'; ch<='9'; ch++){
            if(isvalid(board,ch,row,col)){
                board[row][col]=ch;
                if(solve(board,nr,nc)==true) return true;
                    board[row][col]='.'; //backtracking
            }
        }
             return false;    
    }
    void solveSudoku(vector<vector<char>>& board){
          solve(board,0,0);
    }
};
   
